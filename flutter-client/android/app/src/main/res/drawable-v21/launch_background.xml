<?xml version="1.0" encoding="utf-8"?>
<!-- Launch window for Android 11 and earlier: the app mark in the middle and
     the studio line at the foot, on the same surface the app paints first. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background_dark"/>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_icon"/>
    </item>
    <item android:bottom="40dp">
        <bitmap
            android:gravity="bottom|center_horizontal"
            android:src="@drawable/splash_branding"/>
    </item>
</layer-list>