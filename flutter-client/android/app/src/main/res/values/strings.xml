<?xml version="1.0" encoding="utf-8"?>
<!--
  Facebook Login needs its identifiers here, not in Dart: the native SDK reads
  them from resources before any Flutter code runs, so there is no way to hand
  them over at runtime.

  Fill all three from the Facebook app at developers.facebook.com:
    facebook_app_id           Settings > Basic > App ID
    facebook_client_token     Settings > Advanced > Client token
    fb_login_protocol_scheme  the literal string "fb" followed by the App ID

  Leaving them empty is safe. AutoInitEnabled is false in the manifest, so the
  SDK does nothing until a login is attempted, and the button that would
  attempt one is hidden unless the build also carries
  the dart-define flag=FACEBOOK_APP_ID=…
-->
<resources>
    <string name="facebook_app_id"></string>
    <string name="facebook_client_token"></string>
    <string name="fb_login_protocol_scheme"></string>
</resources>
