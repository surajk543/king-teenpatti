<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: nothing of this app leaves the phone, by cloud
     backup or by device-to-device transfer. See the note on <application> in
     AndroidManifest.xml — the SharedPreferences carry the session JWT and the
     guest deviceId, which is a guest's whole account. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
