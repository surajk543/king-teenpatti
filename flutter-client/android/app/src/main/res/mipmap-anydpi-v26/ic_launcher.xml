<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (Android 8+): the crown-and-cards mark rendered from
     assets/app_icon.svg by `flutter test tool/render_icons.dart`, on the same
     slate ground the artwork uses. Android 12+ also draws its splash from it. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
