<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>King Teen Patti</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>teenpatti</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Google sign-in. Both values come from ios/Flutter/Debug.xcconfig and
	     Release.xcconfig so the client id is one line to set and lives beside
	     the other build settings rather than inside a source file. Empty until
	     an iOS OAuth client exists (docs/ios-setup.md); guest play is
	     unaffected either way. -->
	<key>GIDClientID</key>
	<string>$(GOOGLE_IOS_CLIENT_ID)</string>
	<!-- The WEB client, the audience the server checks a Google token against
	     (GOOGLE_CLIENT_IDS). It has to be HERE on iOS: the plugin passes
	     Dart's serverClientId on only when a clientId comes with it, and
	     otherwise Google's SDK reads this file alone - without this key the
	     token's audience is the iOS client and the server refuses it
	     (401 invalid_token). The same value as SocialSignIn.serverClientId
	     and every config/*.json; test/ios_google_sign_in_test.dart holds
	     them together. A public id, not a secret. -->
	<key>GIDServerClientID</key>
	<string>265025011940-0k4kh3ljcopn2pmkpb0q1rhbe8er8h09.apps.googleusercontent.com</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>google-sign-in</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GOOGLE_IOS_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<!-- Export compliance, answered here so App Store Connect does not ask at
	     every upload: the app uses no encryption of its own, only HTTPS/TLS
	     and the system's (Apple's "exempt" case). -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- The Android manifest carries usesCleartextTraffic for exactly one
	     reason: a debug build pointed at a game server on the development
	     machine (SERVER_URL=http://…). This is that permission and no more —
	     production is https://prod.sungamestudio.com, and arbitrary cleartext
	     stays refused. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- Requirement 23: landscape only, either way up. main() asks for the same
	     two through SystemChrome, but that only narrows what the system already
	     allows — a portrait entry here would let the launch screen and the first
	     frame appear sideways before Dart ever runs. -->
	<!-- A landscape-only app on iPad must opt out of multitasking (Split View
	     and Slide Over), or App Store Connect refuses the upload: "iPad
	     Multitasking support requires these orientations: Portrait, …"
	     (ITMS-90474). The table is laid out for the whole screen anyway. -->
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- The Android build runs immersive-sticky (main.dart). SystemUiMode is a
	     no-op on iOS, so the status bar is hidden here instead, from launch
	     rather than from the first frame. -->
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
