# Copy to .env next to docker-compose.yml. Read by `docker compose`, not by the
# game server (the server has its own go-server/.env).

# --- Grafana ---------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
# Required. Compose refuses to start without it.
GRAFANA_ADMIN_PASSWORD=change-me
# Where Grafana is published on the host. 3000 is taken by the game server.
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3001
# What Grafana believes its public URL is (links in alerts, OAuth callbacks).
GRAFANA_ROOT_URL=http://localhost:3001

# --- Prometheus ------------------------------------------------------------
PROMETHEUS_BIND=127.0.0.1
PROMETHEUS_PORT=9090
PROMETHEUS_EXTERNAL_URL=http://localhost:9090
# How long samples are kept. 15 s scrape interval ≈ 1–2 GB per 15 days here.
PROMETHEUS_RETENTION=15d

# --- postgres_exporter -----------------------------------------------------
# The exporter connects from the compose network (172.30.0.0/24), so Postgres
# must listen on the docker gateway and pg_hba.conf must allow that subnet.
# Prefer a read-only monitoring role over the superuser (MONITORING.md):
#   CREATE ROLE postgres_exporter LOGIN PASSWORD '...'; GRANT pg_monitor TO postgres_exporter;
POSTGRES_EXPORTER_DSN=postgresql://postgres:postgres@host.docker.internal:5432/gameplay?sslmode=disable

# --- nginx-prometheus-exporter --------------------------------------------
# The stub_status server from nginx/king-teenpatti.conf.example. Loopback-only
# (127.0.0.1:8080) is NOT reachable from a container; use `listen 8080;` with
# the allow-list, or run the exporter on the host.
NGINX_STUB_STATUS_URL=http://host.docker.internal:8080/stub_status

# --- node_exporter ---------------------------------------------------------
# Runs in host network mode. Prometheus connects via the docker gateway, so the
# listener cannot be loopback-only; firewall :9100 from the outside instead.
NODE_EXPORTER_BIND=0.0.0.0
