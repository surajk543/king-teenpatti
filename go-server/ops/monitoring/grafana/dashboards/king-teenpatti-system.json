          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(rate(node_network_transmit_bytes_total{job=\"node\",device!~\"lo|veth.*|br-.*|docker.*\"}[1m])) * 8",
          "legendFormat": "transmit",
          "range": true,
          "instant": false
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 14
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Open file descriptors",
      "description": "One descriptor per websocket in the game server (plus the pg pool and logs) and two per proxied websocket in nginx. The dashed line is the game server process's RLIMIT_NOFILE — raise it with the systemd drop-in in ops/monitoring/nginx/systemd/.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
