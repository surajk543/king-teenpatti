{
  "uid": "king-teenpatti-logs",
  "title": "King Teen Patti — Logs",
  "description": "The game server's journal (slog JSON, shipped by Alloy to Loki): volume, warnings and errors, logins and money events, restarts and live-store health, and a filtered log view.",
  "tags": [
    "king-teenpatti",
    "game-server",
    "loki"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "fiscalYearStartMonth": 0,
  "weekStart": "",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "king-teenpatti"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "title": "King Teen Patti dashboards",
      "icon": "external link",
      "targetBlank": false
    },
    {
      "title": "Runbook (MONITORING.md)",
      "type": "link",
      "icon": "doc",
      "targetBlank": true,
      "url": "https://github.com/surajk543/king-teenpatti/blob/master/go-server/ops/monitoring/MONITORING.md",
      "tooltip": "What each panel means and what to do when it goes red"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Game server starts",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "orange",
        "expr": "{service_name=\"gameplay\"} | json | msg=\"gameplay build\"",
        "maxLines": 100,
        "instant": false,
        "titleFormat": "Game server started",
        "textFormat": "{{version}} {{go}}"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "DS_LOKI",
        "label": "Loki",
        "query": "loki",
        "current": {
          "selected": false,
          "text": "Loki",
          "value": "loki"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      },
      {
        "type": "custom",
        "name": "level",
        "label": "Level",
        "description": "slog level of the lines shown in All logs.",
        "query": "INFO,WARN,ERROR",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "$__all"
          },
          {
            "selected": false,
            "text": "INFO",
            "value": "INFO"
          },
          {
            "selected": false,
            "text": "WARN",
            "value": "WARN"
          },
          {
            "selected": false,
            "text": "ERROR",
            "value": "ERROR"
          }
        ],
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "type": "textbox",
        "name": "search",
        "label": "Search",
        "description": "Regex over the whole line (a userId, a room code, an error text).",
        "query": "",
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "options": [
          {
            "selected": false,
            "text": "",
            "value": ""
          }
        ],
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "type": "textbox",
        "name": "msg",
        "label": "Message",
        "description": "Regex over the msg field, e.g. `login refused` or `table .*`.",
        "query": ".*",
        "current": {
          "selected": false,
          "text": ".*",
          "value": ".*"
        },
        "options": [
          {
            "selected": false,
            "text": ".*",
            "value": ".*"
          }
        ],
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Volume",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Log lines",
      "description": "Journal lines from the game server in the selected range.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=\"gameplay\"} [$__range]))",
          "queryType": "instant"
