  "tags": [
    "game-server",
    "king-teenpatti",
    "prometheus",
    "split"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "liveNow": false,
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 1,
  "fiscalYearStartMonth": 0,
  "weekStart": "",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "king-teenpatti"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "title": "King Teen Patti dashboards",
      "icon": "external link",
      "targetBlank": false
    },
    {
      "title": "Runbook (MONITORING.md)",
      "type": "link",
      "url": "https://github.com/surajk543/king-teenpatti/blob/master/go-server/ops/monitoring/MONITORING.md",
      "icon": "doc",
      "targetBlank": true,
      "tooltip": "What each panel means and what to do when it goes red"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Game server restarts",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "orange",
        "expr": "changes(game_server_process_start_time_seconds[2m]) > 0",
        "step": "15s",
        "titleFormat": "Game server restarted",
        "textFormat": "game_server_process_start_time_seconds changed"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "query": "prometheus",
        "current": {
          "selected": false,
          "text": "Prometheus",
          "value": "prometheus"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 14,
      "type": "stat",
      "title": "Uptime",
      "description": "Seconds since the game server process started (game_server_process_uptime_seconds). A reset here with no deploy is a crash — check the restart annotation and journalctl -u gameplay.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "game_server_process_uptime_seconds",
          "legendFormat": "uptime",
          "range": true,
          "instant": false
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      }
    },
