{
  "name": "king-teenpatti-server",
  "version": "1.0.0",
  "description": "Turn-based Teen Patti game server (Node.js + Socket.IO + PostgreSQL)",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test --test-timeout=30000 \"test/*.test.js\"",
    "loadtest": "node test/loadtest.js",
    "bot": "node tools/bot.js",
    "parity": "node tools/parity.mjs",
    "parity:diff": "node tools/parity-diff.mjs"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "google-auth-library": "^9.14.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "redis": "^4.7.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
