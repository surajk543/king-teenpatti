# ---- Server ----
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated list of allowed browser origins. "*" allows everything (dev only).
CORS_ORIGIN=*

# ---- Auth ----
# Secret used to sign session JWTs. MUST be changed in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Google Sign-In: OAuth client IDs that are allowed to issue id_tokens for this game.
# Add every platform client id you created (web, android, ios), comma separated.
GOOGLE_CLIENT_IDS=

# Facebook Login: used to verify user access tokens via the Graph API debug_token endpoint.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Set to true to skip real provider verification and trust the client-sent profile.
# ONLY for local development / automated tests.
AUTH_ALLOW_FAKE_PROVIDERS=false

# ---- Database (PostgreSQL) ----
# Every chip movement is one transaction: the wallet row is locked, the pot and
# the append-only ledger are written, and the table state is versioned — and
# only a committed transaction changes what players see.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gameplay
# Schema the tables live in. Tests point this at a throwaway schema each.
PG_SCHEMA=public
PG_POOL_MAX=10

# ---- Game economy ----
WELCOME_CHIPS=200000
BOOT_AMOUNT=200
# Stakes the lobby offers, as "Blind" and "Seen" categories of each.
# Leave empty to allow any stake (used by the test suite for isolation).
TABLE_STAKES=200,5000
# The rooms the lobby offers, as category:boot pairs, in display order.
# Leave empty to allow any pair (used by the test suite for isolation).
LOBBY_TABLES=seen:200,blind:200,blind:5000
MAX_PLAYERS_PER_ROOM=5
MIN_PLAYERS_TO_START=2
TURN_TIMEOUT_MS=25000
# Round cap before the table is forced to a showdown (prevents endless pots).
MAX_BET_ROUNDS=20
# Hard ceiling on a single chaal, as a multiple of the boot amount.
POT_LIMIT_MULTIPLIER=1024
# Rungs on the +/- raise ladder. Each "+" doubles the bet (base, 2x, 4x ...);
# the ladder is also cut short by the pot limit and by the player's own chips,
# so a player is never offered a bet larger than their stack.
MAX_RAISE_STEPS=8

# Seen tables play tighter (requirement 19): one double per turn, and a forced
# showdown once everybody has had 7 turns.
SEEN_MAX_RAISE_STEPS=2
SEEN_MAX_BET_ROUNDS=7
# Blind tables (200 and 5000) are open-ended: 0 means no limit for each of these.
# The ladder doubles until the player's stack stops it, a single bet has no
# ceiling of its own, and the turn rotates until someone packs or shows.
BLIND_MAX_RAISE_STEPS=0
BLIND_MAX_BET_ROUNDS=0
BLIND_POT_LIMIT_MULTIPLIER=0
# Pot ceiling on seen tables (0 = uncapped). Blind tables have no ceiling.
SEEN_MAX_POT=1200000

# Blind bets allowed before a player's cards turn face up by themselves.
MAX_BLIND_MOVES=4

# Requirement 30: players holding more than this cannot join the given table
# from the lobby (not checked on a table switch). Cap 0 disables it.
ENTRY_CAP_BOOT=200
ENTRY_CAP_CATEGORY=blind
ENTRY_CAP_MAX_CHIPS=500000

# Requirement 31: consecutive timed-out turns before the seat is given up.
MAX_MISSED_TURNS=3

# Requirement 33: how long a sideshow request stands, and the fewest active
# players for one to be offered.
SIDESHOW_TIMEOUT_MS=6000
SIDESHOW_MIN_PLAYERS=3

# Requirement 29: longest display name accepted.
DISPLAY_NAME_MAX=24

# Countdown before the next deal, and how long a dropped connection keeps its seat.
NEXT_HAND_DELAY_MS=4000
RECONNECT_GRACE_MS=60000
# After the held seat lapses, how long the server still remembers the table a
# player fell off — a reopened app is sat straight back down there. 0 disables.
RESUME_OFFER_MS=600000

# error | warn | info | debug
LOG_LEVEL=info

# Prometheus metrics (requirement 35). /metrics is open unless a token and/or
# an IP allow-list is set; do both before exposing the server to the internet.
METRICS_ENABLED=true
METRICS_PATH=/metrics
METRICS_PREFIX=game_server_
METRICS_TOKEN=
METRICS_ALLOW_IPS=

# Private tables (requirement 22): reached by code rather than the lobby. The
# boot is fixed rather than chosen, the win is capped, and a player may double
# their chaal only once per turn.
PRIVATE_BOOT=200
PRIVATE_MAX_POT=500000
PRIVATE_MAX_RAISE_STEPS=2

# How often two rooms that have each dwindled to a single player are merged
# together (requirement 24). Also runs immediately whenever someone leaves.
CONSOLIDATE_INTERVAL_MS=15000

# ---- Room chat ----
# Chat is per-room and lives in server memory only. It is never written to the
# database, and the whole log is discarded when the last player leaves a room.
CHAT_MAX_HISTORY=100
CHAT_MAX_LENGTH=140
# Messages allowed per player per window, to stop one player flooding a table.
CHAT_RATE_LIMIT=5
CHAT_RATE_WINDOW_MS=5000

# ---- Horizontal scaling (optional) ----
# When set, Socket.IO uses the Redis adapter so multiple node processes share rooms.
REDIS_URL=
