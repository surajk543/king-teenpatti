# /etc/nginx/nginx.conf — MAIN-context settings for a websocket proxy.
#
# Only the top of the file matters here; the http {} block is Ubuntu's stock
# one with the site include. Diff against your distribution's file and carry
# the marked lines over rather than replacing it wholesale.
#
# WHY: in the 2026-09-08 load tests (loadtest-report/production-2026-09-08-*)
# api.sungamestudio.com started answering every new connection and Socket.IO
# handshake with HTTP 500 at ~1,500 players, twice, while Node itself was at
# 3% CPU. error.log said "worker_connections are not enough". Ubuntu ships
# worker_connections 768 and 4 workers = 3,072 connections, and a proxied
# websocket costs TWO (the client leg and the upstream leg to Node), so the
# ceiling was 768 × 4 ÷ 2 ≈ 1,500 players. The values below lift it to
# 16384 × 4 ÷ 2 = 32,768 players per box; Node's own fd limit (see
# systemd/king-teenpatti-limits.conf) has to be raised to match.

user www-data;
worker_processes auto;                      # one per core
pid /run/nginx.pid;
error_log /var/log/nginx/error.log;
include /etc/nginx/modules-enabled/*.conf;

# CHANGED: the per-worker open-file limit. Must be ≥ worker_connections × 2
# (every proxied connection is two descriptors) and ≤ the LimitNOFILE the
# systemd unit grants (systemd/nginx-limits.conf sets 65536).
worker_rlimit_nofile 65536;

events {
    # CHANGED: Ubuntu default is 768 — the ~1,500-player ceiling above.
    worker_connections 16384;
    # CHANGED: epoll is the right notifier on Linux (auto-selected, made explicit).
    use epoll;
    # CHANGED: accept every pending connection per wake-up, not one at a time;
    # matters when 100 players connect in the same second.
    multi_accept on;
}

http {
    sendfile on;
    tcp_nopush on;
    types_hash_max_size 2048;
    server_tokens off;

    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    access_log /var/log/nginx/access.log;

    gzip on;

    include /etc/nginx/conf.d/*.conf;
    include /etc/nginx/sites-enabled/*;
}
