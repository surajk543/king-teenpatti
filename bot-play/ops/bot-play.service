[Unit]
Description=King Teen Patti bot fleet (bot-play)
Documentation=file:///var/www/gameplay/king-teenpatti/bot-play/README.md
# Wants, not Requires: the fleet waits for the game server (it polls
# GET /api/tables) rather than failing when it is not up yet. A unit that
# restart-loops on boot order is worse than one that waits quietly.
After=network-online.target gameplay.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/gameplay/king-teenpatti/bot-play
ExecStart=/var/www/gameplay/king-teenpatti/bot-play/bin/bot-play -config configs/bot.yaml
# Loopback on purpose: no nginx, no TLS, no edge filter between the fleet and
# the game it plays. See README.
Environment=BOT_MODE=server
Environment=SERVER_URL=http://127.0.0.1:3000
# 320 bots: online about 70% of the time and seated a little less, so about
# 200 sit at once — 30 to 50 at each of the five lobby tables below (owner,
# 27 Sep 2026); a table holding 50 of the fleet takes no more.
Environment=BOT_COUNT=320
Environment=BOT_LOBBY_TABLES=seen:200,seen:50000,blind:200,blind:50000,variation:50000
Environment=BOT_FLEET_PER_TABLE=30,50
# 20 boots, so a fresh 10 Lakh account can sit at the 50,000 tables.
Environment=BOT_BOOTS_TO_SIT=20
Environment=BOT_METRICS_ADDR=127.0.0.1:9101
# The debug view lists every bot and its user id: loopback only (config
# refuses anything else), and on a port of its own.
Environment=BOT_DEBUG_ADDR=127.0.0.1:9102
Restart=always
RestartSec=15
# SIGTERM: every bot finishes its hand (up to 60 s), leaves its table and
# disconnects, so no seat is left for the 60-second reconnect grace.
KillSignal=SIGTERM
TimeoutStopSec=75
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
